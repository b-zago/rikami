{{conf "chart"}}
---
{{- cast "Chart" "chart" -}}
{{- cast "Redis" "redis" -}}
{{- cast "Postgres-deploy" "db" -}}
{{- cast "Webserver" "webServer" -}}
{{- global "env" "staging" -}}
---
{{override .chart.Main "description" "Scorevaulting test app"}}
{{override .chart.Main "name" "scorevaulting"}}
{{append .chart.Main "dependencies[0]" (map "version" "0.1.1")}}
{{$prefix := print .chart.Main.name "-"}}

{{override .db.Secrets "data" (secMake ".env.secret" .Globals.Values.env .db.Secrets.name)}}

{{override .webServer.Routes "host" "scorevaultin.zagoapps.com"}}
{{override .webServer.Services "targetPort" 8000}}
{{override .webServer.Deployments "image" "ghcr.io/b-zago/scorevault/webserver:latest"}}
{{override .webServer.Deployments "runsOn" "python"}}

{{override .webServer.Deployments "envVars" (envGen "DB_HOST" (print $prefix .db.Services.name) "REDIS" (print $prefix .redis.Services.name))}}
{{override .webServer.Deployments "envSecretRefs" (list .db.Secrets.name)}}
{{append .db.Secrets "runsOnList" (list .webServer.Deployments.name)}}
{{summon}}
