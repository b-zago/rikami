{{shard "Redis"}}

{{begin "Services"}}
{{set "name" "redis-service"}}
{{set "runsOn" "redis"}}
{{set "port" 6379}}
{{set "targetPort" 6379}}
{{set "custom" (map "custom1" "custom1val" "custom2" "custom2val")}}

{{begin "Deployments"}}
{{set "name" "redis"}}
{{set "image" "redis:8-alpine"}}
{{set "runsOn" "redis"}}
{{set "component" "cache"}}
{{bind "containerPort" "Services@targetPort"}}
{{bind "bindedMapValue" "Services@custom@custom1"}}

{{seal}}
