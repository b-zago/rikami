{{shard "Webserver"}}
{{begin "Routes"}}

{{set "name" "web-server-route"}}
{{set "runs-on" "web-server-service"}}
{{receive "host"}}

{{begin "Services"}}
{{set "name" "web-server-service"}}
{{set "runs-on" "web-server"}}
{{set "port" 80}}
{{set "targetPort" 3213}}

{{begin "Deployments"}}
{{set "name" "web-server"}}
{{receive "image"}}
{{set "imagePullSecret" "ghcr-creds"}}
{{receive "runsOn"}}
{{set "component" "server"}}
{{bind "containerPort" "Services@targetPort"}}

{{seal}}
